generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SHAREHOLDER
}

model Company {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  classes       ShareClass[]
  announcements Announcement[]

  @@map("companies")
}

model ShareClass {
  id           String              @id @default(uuid()) @db.Uuid
  companyId    String              @db.Uuid
  company      Company             @relation(fields: [companyId], references: [id])
  name         String
  issuedShares BigInt
  holdings     Shareholding[]
  valuations   ValuationSnapshot[]
  dividends    DividendRecord[]

  @@unique([companyId, name])
  @@map("share_classes")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  passwordHash    String?
  role            Role           @default(SHAREHOLDER)
  active          Boolean        @default(true)
  inviteHash      String?        @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime       @default(now())
  shareholder     Shareholder?
  auditLogs       AuditLog[]
  holdingEvents   HoldingEvent[]

  @@map("users")
}

model Shareholder {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @unique @db.Uuid
  user                  User             @relation(fields: [userId], references: [id])
  legalName             String
  verifiedAt            DateTime?
  verificationReference String?
  holdings              Shareholding[]
  dividends             DividendRecord[]

  @@map("shareholders")
}

model Shareholding {
  id                    String         @id @default(uuid()) @db.Uuid
  shareholderId         String         @db.Uuid
  shareholder           Shareholder    @relation(fields: [shareholderId], references: [id])
  shareClassId          String         @db.Uuid
  shareClass            ShareClass     @relation(fields: [shareClassId], references: [id])
  quantity              BigInt
  recordedAt            DateTime       @default(now())
  verifiedAt            DateTime?
  verificationReference String?
  events                HoldingEvent[]

  @@unique([shareholderId, shareClassId])
  @@map("shareholdings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetId   String?
  createdAt  DateTime @default(now())
  targetType String?
  reason     String?
  requestId  String?  @db.Uuid
  metadata   Json?

  @@index([targetId, createdAt])
  @@map("audit_logs")
}

enum HoldingEventKind {
  OPENING
  ADJUSTMENT
  VERIFICATION
  LEGACY_BASELINE
}

model HoldingEvent {
  id              String           @id @default(uuid()) @db.Uuid
  holdingId       String           @db.Uuid
  holding         Shareholding     @relation(fields: [holdingId], references: [id], onDelete: Restrict)
  actorId         String?          @db.Uuid
  actor           User?            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  sequence        Int
  kind            HoldingEventKind
  beforeQuantity  BigInt
  delta           BigInt
  afterQuantity   BigInt
  reason          String
  sourceReference String
  verifiedAt      DateTime?
  effectiveAt     DateTime
  createdAt       DateTime         @default(now())
  requestId       String?          @db.Uuid

  @@unique([holdingId, sequence])
  @@index([holdingId, createdAt])
  @@map("holding_events")
}

model Announcement {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  title           String
  body            String
  datedAt         DateTime  @db.Date
  sourceReference String
  createdAt       DateTime  @default(now())
  publishedAt     DateTime?
  withdrawnAt     DateTime?

  @@index([companyId, datedAt])
  @@map("announcements")
}

model ValuationSnapshot {
  id              String     @id @default(uuid()) @db.Uuid
  shareClassId    String     @db.Uuid
  shareClass      ShareClass @relation(fields: [shareClassId], references: [id], onDelete: Restrict)
  asOf            DateTime   @db.Date
  pricePerShare   Decimal    @db.Decimal(28, 8)
  currency        String     @db.Char(3)
  methodology     String
  sourceReference String
  createdAt       DateTime   @default(now())
  publishedAt     DateTime?
  withdrawnAt     DateTime?

  @@index([shareClassId, asOf])
  @@map("valuation_snapshots")
}

enum DividendStatus {
  DECLARED
  PAID
}

model DividendRecord {
  id            String           @id @default(uuid()) @db.Uuid
  shareholderId String           @db.Uuid
  shareholder   Shareholder      @relation(fields: [shareholderId], references: [id], onDelete: Restrict)
  shareClassId  String           @db.Uuid
  shareClass    ShareClass       @relation(fields: [shareClassId], references: [id], onDelete: Restrict)
  status        DividendStatus
  declarationId String?          @db.Uuid
  declaration   DividendRecord?  @relation("DividendPayments", fields: [declarationId], references: [id], onDelete: Restrict)
  payments      DividendRecord[] @relation("DividendPayments")
  amount        Decimal          @db.Decimal(28, 8)
  currency      String           @db.Char(3)
  datedAt       DateTime         @db.Date
  reference     String
  createdAt     DateTime         @default(now())
  publishedAt   DateTime?
  withdrawnAt   DateTime?

  @@unique([shareholderId, shareClassId, reference])
  @@index([shareholderId, datedAt])
  @@map("dividend_records")
}
